#!/usr/bin/env bash
set -euo pipefail

SRC_DEFAULT="${HOME}/Documents/Wallpapers/Wallpapers"

usage() {
  cat <<HELP
Usage: $(basename "$0") <theme-dir> [source-dir]

Recolor wallpapers from source-dir into the theme's background directory
using the theme's color palette (colors.toml).

This script uses 'lutgen' to create high-quality smooth color mappings
without dithering artifacts.

Arguments:
  theme-dir    Path to theme directory (must contain colors.toml and backgrounds/)
  source-dir   Directory with source wallpapers (default: ${SRC_DEFAULT})
HELP
  exit 1
}

THEME_DIR="${1:-}"
SRC_DIR="${2:-$SRC_DEFAULT}"

if [ -z "$THEME_DIR" ] || [ "$THEME_DIR" = "-h" ] || [ "$THEME_DIR" = "--help" ]; then
  usage
fi

[ ! -f "$THEME_DIR/colors.toml" ] && echo "Error: no colors.toml in $THEME_DIR" && exit 1

BG_DIR="$THEME_DIR/backgrounds"
mkdir -p "$BG_DIR"

if ! command -v lutgen >/dev/null 2>&1; then
  echo "Error: 'lutgen' is not installed."
  echo "Please install lutgen (Arch: the lutgen-bin AUR package)"
  exit 1
fi

echo "Extracting palette from $THEME_DIR/colors.toml..."
COLORS=$(python3 -c "
import sys, tomllib
with open(sys.argv[1], 'rb') as f:
    data = tomllib.load(f)
colors = data.get('colors', data)
seen = set()

# Try to parse legacy numbered format
for i in range(256):
    key = f'color{i}'
    if key in colors:
        c = '#' + colors[key].strip().lstrip('#')
        if c not in seen:
            seen.add(c)
            print(c)

# If no numbered colors exist (e.g. new 24-color palettes), extract all valid hex colors
if len(seen) == 0:
    for key, val in colors.items():
        if isinstance(val, str) and val.startswith('#'):
            c = '#' + val.strip().lstrip('#')
            if c not in seen:
                seen.add(c)
                print(c)
" "$THEME_DIR/colors.toml")

# Convert python output lines to an array
mapfile -t LUTGEN_COLORS <<< "$COLORS"

if [ ${#LUTGEN_COLORS[@]} -eq 0 ]; then
  echo "Error: no colors found in colors.toml"
  exit 1
fi

echo "Palette: ${#LUTGEN_COLORS[@]} unique colors"

# Create a temporary directory to store lutgen output before moving it
TMP_OUT=$(mktemp -d /tmp/lutgen-out-XXXXXX)
trap 'rm -rf "$TMP_OUT"' EXIT

# Find all valid image files; GIF and video go through ffmpeg (lutgen apply only takes stills).
echo "Finding images in $SRC_DIR..."
mapfile -t FILES < <(find "$SRC_DIR" -maxdepth 1 -type f \( -iname \*.jpg -o -iname \*.jpeg -o -iname \*.png -o -iname \*.webp \))
mapfile -t MEDIA < <(find "$SRC_DIR" -maxdepth 1 -type f \( -iname \*.gif -o -iname \*.mp4 -o -iname \*.webm -o -iname \*.mkv -o -iname \*.mov -o -iname \*.m4v \))

if [ ${#FILES[@]} -eq 0 ] && [ ${#MEDIA[@]} -eq 0 ]; then
  echo "No images found in $SRC_DIR"
  exit 0
fi

if [ ${#FILES[@]} -gt 0 ]; then
  echo "Processing ${#FILES[@]} images with lutgen (this might take a moment)..."
  lutgen apply -o "$TMP_OUT" "${FILES[@]}" -- "${LUTGEN_COLORS[@]}"
fi

# Live wallpapers: one Hald CLUT from the same palette (lutgen generate), applied to every frame with
# ffmpeg's haldclut. GIF stays GIF (own palette per file), video becomes H.264 mp4 (owe plays it).
if [ ${#MEDIA[@]} -gt 0 ]; then
  command -v ffmpeg >/dev/null 2>&1 || { echo "Error: ffmpeg is needed to recolor GIF / video"; exit 1; }
  LUT="$TMP_OUT/.hald.png"
  lutgen generate -o "$LUT" -- "${LUTGEN_COLORS[@]}"
  for m in "${MEDIA[@]}"; do
    base=$(basename "$m"); stem=${base%.*}
    echo "Recoloring $base (ffmpeg haldclut)..."
    case "${base,,}" in
    *.gif)
      ffmpeg -nostdin -loglevel error -y -i "$m" -i "$LUT" -filter_complex \
        "[0:v][1:v]haldclut,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=sierra2_4a" \
        -loop 0 "$TMP_OUT/$stem.gif" ;;
    *)
      ffmpeg -nostdin -loglevel error -y -i "$m" -i "$LUT" -filter_complex "[0:v][1:v]haldclut,format=yuv420p" \
        -c:v libx264 -crf 20 -preset medium -movflags +faststart -an "$TMP_OUT/$stem.mp4" ;;
    esac
  done
  rm -f "$LUT"
fi

echo "Copying processed wallpapers to $BG_DIR..."
# Move processed files to background dir and cleanup old files with same basename
for f in "$TMP_OUT"/*; do
  [ -e "$f" ] || continue
  base=$(basename "$f" | sed 's/\.[^.]*$//')
  # remove any existing file in backgrounds with the same base name to avoid duplicates
  rm -f "$BG_DIR/$base".*
  cp "$f" "$BG_DIR/"
done

EXISTING=$(find "$BG_DIR" -maxdepth 1 -type f | wc -l)
echo "Done! Backgrounds in $BG_DIR: $EXISTING files"
