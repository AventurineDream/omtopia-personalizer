{
  "name": "NIHIL",
  "name_ru": "NIHIL",
  "note": "Nothing-inspired hardware shell on any theme: bezel frame with windows flush against it, vertical LED bar, dot-matrix typography, signal colour strictly for alerts, perimeter Glyph lighting, LED dashboard/OSD/launcher/lock and a tactile sound pack.",
  "note_ru": "Аппаратная оболочка в духе Nothing на любой теме: рамка-бортик с окнами вплотную, вертикальный LED-бар, матричная типографика, сигнальный цвет строго для тревог, контурная подсветка Glyph, LED-дашборд/OSD/лаунчер/локскрин и тактильный звуковой пакет.",
  "anims": "NIHIL",
  "opacity": "nihil",
  "blur": "nihil",
  "shader": "off",
  "hyprGeometry": {
    "gapsIn": 4,
    "gapsOut": 8,
    "borderSize": 1,
    "rounding": 12,
    "shadow": false,
    "noGaps": true
  },
  "barSkinData": {
    "note": "NIHIL bezel frame (44px bar, 8px frame, 20px inner corners, 1px hairline border, LED workspaces); colours from the Nihil palette — theme or mono",
    "note_ru": "Рамка-бортик NIHIL (бар 44px, рамка 8px, скруглённые углы 20px, тонкий контур 1px, LED-воркспейсы); цвета из палитры Nihil — тема или монохром",
    "shape": "frame",
    "height": 44,
    "frameWidth": 8,
    "radius": 20,
    "padding": 16,
    "spacing": 10,
    "background": "nihil.bg",
    "backgroundAlpha": 1,
    "border": "nihil.line",
    "borderWidth": 1,
    "borderAlpha": 1,
    "text": "nihil.fg",
    "active": "nihil.signal",
    "moduleStyle": "plain",
    "wsLabelStyle": "leds",
    "wsWindowIcons": false,
    "wsShowEmpty": true,
    "compact": "off",
    "transparent": false,
    "wsMaxIcons": 3
  },
  "barLayoutData": {
    "position": "left",
    "centerAnchor": "active-app",
    "layout": {
      "left": [
        {
          "id": "nihil-mark",
          "type": "qml",
          "source": "~/.config/omarchy/plugins/kamradsmeshnyavy.bar/modules/NihilMark.qml"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "active-app",
          "type": "qml",
          "source": "~/.config/omarchy/plugins/kamradsmeshnyavy.bar/modules/ActiveAppIcon.qml"
        }
      ],
      "right": [
        {
          "id": "kamradsmeshnyavy.tray",
          "pinned": [],
          "hidden": []
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "kamradsmeshnyavy.network"
        },
        {
          "id": "kamradsmeshnyavy.bluetooth"
        },
        {
          "id": "kamradsmeshnyavy.audio"
        },
        {
          "id": "battery-gauge",
          "type": "qml",
          "source": "~/.config/omarchy/plugins/kamradsmeshnyavy.bar/modules/BatteryGauge.qml"
        },
        {
          "id": "dot-clock",
          "type": "qml",
          "source": "~/.config/omarchy/plugins/kamradsmeshnyavy.bar/modules/DotClock.qml"
        },
        {
          "id": "privacy-led",
          "type": "qml",
          "source": "~/.config/omarchy/plugins/kamradsmeshnyavy.bar/modules/PrivacyLed.qml"
        }
      ]
    }
  },
  "barTransparent": false,
  "lock": {
    "design": "nihil",
    "wallpaperBlur": 0,
    "wallpaperDim": 0.45
  },
  "launcher": {
    "skin": "nihil",
    "backdrop": 0.82
  },
  "wallpaperFx": {
    "type": "fade",
    "duration": 500,
    "easing": "OutCubic"
  },
  "imagePicker": {
    "style": "cards",
    "cardRadius": 14,
    "selectedBorder": 1,
    "dim": 0.55
  },
  "widgets": {
    "widgetStyle": "nihil",
    "clockStyle": "big",
    "dashStyle": "nihil",
    "dashFollowBar": true,
    "dashAttach": "attached",
    "dashBackground": "nihil.bg",
    "dashAlpha": 1,
    "dashRadius": 14,
    "dashBorder": true,
    "dashAnimation": "slide",
    "dashDuration": 240
  },
  "osd": {
    "osdStyle": "nihil",
    "osdFollowBar": true,
    "osdAttach": "attached",
    "osdBackground": "nihil.bg",
    "osdAlpha": 1,
    "osdRadius": 14,
    "osdSide": "right",
    "osdAlign": "center"
  },
  "notifications": {
    "notifyStyle": "stock",
    "notifyFollowBar": true,
    "notifyBackground": "nihil.bg",
    "notifyAlpha": 1,
    "notifyRadius": 14,
    "notifyCards": "nihil",
    "notifyCorner": "top-right",
    "notifyWidth": 360
  },
  "sounds": {
    "soundPack": "nihil",
    "windowSounds": true
  },
  "glyph": {
    "glyphEnabled": true,
    "glyphColor": "nihil.fg",
    "glyphCriticalColor": "nihil.danger",
    "glyphDuration": 1100,
    "glyphThickness": 2.5,
    "glyphInsetMode": "auto"
  },
  "fonts": "pixel"
}
